# Generated for {{ vpn_customer_id }}

connections {
  ikev2-pubkey {
    version = 2
    unique = keep
    local_addrs = %any
    pools = vpn-pool
    send_cert = always
    proposals = aes256gcm16-prfsha256-ecp256

    local {
      auth = pubkey
      certs = server.crt
      id = {{ vpn_server_fqdn }}
    }

    remote {
      auth = pubkey
      id = %any
    }

    children {
      net {
        local_ts = 0.0.0.0/0
        esp_proposals = aes256gcm16-ecp256
        dpd_action = clear
      }
    }
  }
}

pools {
  vpn-pool {
    addrs = {{ vpn_pool }}
    dns = {{ vpn_dns_servers }}
  }
}

